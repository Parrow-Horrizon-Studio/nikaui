{
  "name": "@nikaui/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ui/*": "./src/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@nikaui/eslint-config": "workspace:*",
    "@nikaui/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.2",
    "@types/culori": "^4.0.1",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
